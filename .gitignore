node_modules/
dist/
*.tsbuildinfo
coverage/

# site's deployable build output (tsc compiles to dist/ like every other package; the
# generated static HTML/CSS site is a separate, deployable artifact, not committed)
site/public/

.env
.env.*

# Cloudflare Workers local-dev secret simulation — never commit
.dev.vars
.dev.vars.*

# private key material — never commit signing/wallet keys
*.pem
*.key
*private-key*

# contains a live GITHUB_TOKEN in plaintext — never commit
docs/keys_needed_datum.md

# data/prints/ and data/runs/ are intentionally NOT excluded here —
# they are git-tracked on purpose. Publication is the product.

# Derived, regenerable local caches (packages/console's event index and agents' local quote
# log) — never a source of truth, never committed.
data/.cache/

# Windows/WSL "mark of the web" sidecar files from downloaded docs
*:Zone.Identifier

# marketing/ (Astro) build caches and local Wrangler state — node_modules/ and dist/ above
# already cover the rest.
.astro/
.wrangler/
marketing/logs/
