{
  "name": "datum",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "pnpm -r run build",
    "typecheck": "pnpm -r run typecheck",
    "lint": "eslint .",
    "format": "prettier --check .",
    "test": "pnpm -r run test",
    "test:contracts": "forge test --root packages/contracts",
    "test:all": "pnpm run test && pnpm run test:contracts",
    "docs:deployments": "node scripts/generate-readme-deployments.mjs",
    "docs:deployments:check": "node scripts/generate-readme-deployments.mjs --check",
    "measure-floor": "tsx scripts/measure-floor.ts",
    "console": "pnpm --filter @datum/console run dev",
    "console:index": "pnpm --filter @datum/console run index"
  },
  "devDependencies": {
    "@datum/prices": "workspace:*",
    "@datum/print": "workspace:*",
    "@datum/sdk": "workspace:*",
    "@eslint/js": "10.0.1",
    "eslint": "10.8.1",
    "eslint-config-prettier": "10.1.8",
    "prettier": "3.9.6",
    "tsx": "^4.20.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.67.0",
    "vitest": "4.1.10"
  }
}
