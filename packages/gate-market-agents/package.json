{
  "name": "@touchstone/gate-market-agents",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.json && mkdir -p dist/skills && cp -r src/skills/*/ dist/skills/",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "smoke-pass": "pnpm run build && node --env-file=../../.env dist/cli/smoke-pass.js",
    "gate-authoring-pass": "pnpm run build && node --env-file=../../.env dist/cli/gate-authoring-pass.js",
    "code-gate-authoring-pass": "pnpm run build && node --env-file=../../.env dist/cli/code-gate-authoring-pass.js",
    "bench-diff": "pnpm run build && node dist/cli/bench-diff.js"
  },
  "dependencies": {
    "@touchstone/agents": "workspace:*",
    "@touchstone/basket": "workspace:*",
    "@touchstone/harness": "workspace:*",
    "@touchstone/print": "workspace:*",
    "@touchstone/sdk": "workspace:*",
    "@touchstone/task-pack-gate-hardening": "workspace:*",
    "@touchstone/task-pack-sdk": "workspace:*",
    "viem": "^2.55.16",
    "yaml": "^2.6.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@touchstone/task-pack-trivial-accept": "workspace:*",
    "@types/node": "^26.2.0"
  }
}
