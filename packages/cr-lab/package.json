{
  "name": "@touchstone/cr-lab",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.typecheck.json --noEmit",
    "test": "vitest run",
    "spend-report": "pnpm run build && node dist/cli/spend-report.js",
    "desk-smoke": "pnpm run build && node dist/cli/desk-smoke.js",
    "calibrate": "pnpm run build && node --env-file=../../.env dist/cli/calibrate.js",
    "snapshot-day": "pnpm run build && node --env-file=../../.env dist/cli/snapshot-day.js",
    "run-day": "pnpm run build && node --env-file=../../.env dist/cli/run-day.js",
    "daily-snapshot": "pnpm run build && node --env-file=../../.env dist/cli/daily-snapshot.js",
    "test-alert": "pnpm run build && node --env-file=../../.env dist/cli/test-alert.js",
    "run-mcp-day": "pnpm run build && node --env-file=../../.env dist/cli/run-mcp-day.js",
    "mcp-login": "pnpm run build && node --env-file=../../.env dist/cli/mcp-login.js",
    "reasoning-overview": "pnpm run build && node --env-file=../../.env dist/cli/reasoning-overview.js",
    "reasoning-tagging": "pnpm run build && node --env-file=../../.env dist/cli/reasoning-tagging.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.31.0",
    "@touchstone/harness": "workspace:*",
    "@touchstone/sdk": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^26.2.0"
  }
}
