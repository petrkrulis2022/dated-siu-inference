{
  "name": "@touchstone/cr-lab",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.typecheck.json --noEmit",
    "test": "vitest run",
    "spend-report": "pnpm run build && node dist/cli/spend-report.js",
    "desk-smoke": "pnpm run build && node dist/cli/desk-smoke.js",
    "calibrate": "pnpm run build && node --env-file=../../.env dist/cli/calibrate.js",
    "snapshot-day": "pnpm run build && node --env-file=../../.env dist/cli/snapshot-day.js",
    "run-day": "pnpm run build && node --env-file=../../.env dist/cli/run-day.js",
    "daily-snapshot": "pnpm run build && node --env-file=../../.env dist/cli/daily-snapshot.js",
    "daily-mcp": "pnpm run build && node --env-file=../../.env dist/cli/daily-mcp.js",
    "test-alert": "pnpm run build && node --env-file=../../.env dist/cli/test-alert.js",
    "run-mcp-day": "pnpm run build && node --env-file=../../.env dist/cli/run-mcp-day.js",
    "mcp-login": "pnpm run build && node --env-file=../../.env dist/cli/mcp-login.js",
    "reasoning-overview": "pnpm run build && node --env-file=../../.env dist/cli/reasoning-overview.js",
    "reasoning-tagging": "pnpm run build && node --env-file=../../.env dist/cli/reasoning-tagging.js",
    "derive-allowances": "pnpm run build && node --env-file=../../.env dist/cli/derive-allowances.js",
    "cr-print": "pnpm run build && node dist/cli/cr-print.js",
    "economy-window": "pnpm run build && node --env-file=../../.env dist/cli/economy-window.js",
    "economy-replay": "pnpm run build && node dist/cli/economy-replay.js",
    "economy-score": "pnpm run build && node dist/cli/economy-score.js",
    "economy-steps": "pnpm run build && node dist/cli/economy-steps.js",
    "studio": "pnpm run build && node dist/cli/studio.js",
    "v3a-window": "pnpm run build && node --env-file=../../.env dist/cli/v3a-window.js",
    "v3a-score": "pnpm run build && node dist/cli/v3a-score.js",
    "v3a-coding": "pnpm run build && node --env-file=../../.env dist/cli/v3a-coding.js",
    "v3a-pass-rates": "pnpm run build && node dist/cli/v3a-pass-rates.js",
    "v3a-volatility": "pnpm run build && node dist/cli/v3a-volatility.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.31.0",
    "@touchstone/harness": "workspace:*",
    "@touchstone/sdk": "workspace:*",
    "viem": "^2.55.16"
  },
  "devDependencies": {
    "@types/node": "^26.2.0"
  }
}
