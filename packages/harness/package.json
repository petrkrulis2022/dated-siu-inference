{
  "name": "@touchstone/harness",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "dry-run": "pnpm run build && node dist/cli/dry-run.js",
    "run": "pnpm run build && node dist/cli/run.js",
    "reconcile": "pnpm run build && node dist/cli/reconcile.js"
  },
  "dependencies": {
    "@touchstone/basket": "workspace:*",
    "@touchstone/sdk": "workspace:*",
    "decimal.js": "^10.6.0"
  },
  "devDependencies": {
    "@types/node": "^26.2.0"
  }
}
