{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "print.schema.json",
  "title": "Print",
  "description": "A signed, dated Dated SIU assessment — build1-spec.md §6, §7. Computed from executed runs only; list prices never feed the print.",
  "type": "object",
  "additionalProperties": false,
  "definitions": {
    "decimalString": {
      "type": "string",
      "pattern": "^-?[0-9]+(\\.[0-9]+)?$",
      "description": "A decimal number encoded as a string. Never a JSON number — no floats in money maths."
    }
  },
  "properties": {
    "version": {
      "type": "string",
      "minLength": 1,
      "description": "Basket version, e.g. SIU-2026a."
    },
    "print_id": {
      "type": "string",
      "minLength": 1
    },
    "date": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "status": {
      "type": "string",
      "enum": ["provisional", "final"]
    },
    "basket_costs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "model_id": { "type": "string", "minLength": 1 },
          "cost_usd": { "$ref": "#/definitions/decimalString" }
        },
        "required": ["model_id", "cost_usd"]
      }
    },
    "weights": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "source": {
          "type": "string",
          "enum": ["routed-market-share", "equal"],
          "description": "build1-spec.md §6.3: which weighting method this print declares it used."
        },
        "values": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "model_id": { "type": "string", "minLength": 1 },
              "weight": { "$ref": "#/definitions/decimalString" }
            },
            "required": ["model_id", "weight"]
          }
        }
      },
      "required": ["source", "values"]
    },
    "dated_siu": { "$ref": "#/definitions/decimalString" },
    "exchange_rate_table": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "model_id": { "type": "string", "minLength": 1 },
          "usd_per_siu": { "$ref": "#/definitions/decimalString" },
          "spread_to_index": { "$ref": "#/definitions/decimalString" },
          "siu_per_usd": { "$ref": "#/definitions/decimalString" }
        },
        "required": ["model_id", "usd_per_siu", "spread_to_index", "siu_per_usd"]
      }
    },
    "floor": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "value": { "$ref": "#/definitions/decimalString" },
        "notes": { "type": "string" }
      },
      "required": ["value"]
    },
    "market_spread": { "$ref": "#/definitions/decimalString" },
    "sensitivity_block": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "policy_variant": { "type": "string", "minLength": 1 },
          "dated_siu": { "$ref": "#/definitions/decimalString" },
          "delta": { "$ref": "#/definitions/decimalString" }
        },
        "required": ["policy_variant", "dated_siu", "delta"]
      }
    },
    "price_snapshot_ref": {
      "type": "string",
      "minLength": 1
    },
    "methodology_version": {
      "type": "string",
      "minLength": 1
    },
    "signature": {
      "type": "string",
      "pattern": "^0x[0-9a-fA-F]+$"
    },
    "public_key": {
      "type": "string",
      "pattern": "^0x[0-9a-fA-F]+$"
    }
  },
  "required": [
    "version",
    "print_id",
    "date",
    "status",
    "basket_costs",
    "weights",
    "dated_siu",
    "exchange_rate_table",
    "floor",
    "market_spread",
    "sensitivity_block",
    "price_snapshot_ref",
    "methodology_version",
    "signature",
    "public_key"
  ]
}
